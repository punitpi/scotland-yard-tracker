// server/socket/gameHandlers.js
const Game = require('../models/game');

module.exports = function(io) {
  io.on('connection', (socket) => {
    console.log('New client connected:', socket.id);
    
    // Join a game room
    socket.on('joinGame', (gameId) => {
      socket.join(gameId);
      console.log(`Client ${socket.id} joined game: ${gameId}`);
    });
    
    // Leave a game room
    socket.on('leaveGame', (gameId) => {
      socket.leave(gameId);
      console.log(`Client ${socket.id} left game: ${gameId}`);
    });
    
    // Basic socket structure for making moves (to be expanded)
    socket.on('makeMove', async (data) => {
      try {
        console.log('Move received:', data);
        
        // Will implement actual move logic in Phase 2
        // For now, just broadcast that a move was attempted
        io.to(data.gameId).emit('moveAttempted', {
          playerId: data.playerId,
          success: true
        });
        
      } catch (error) {
        console.error('Error processing move:', error);
        socket.emit('error', { message: 'Failed to process move' });
      }
    });
    
    socket.on('disconnect', () => {
      console.log('Client disconnected:', socket.id);
    });
  });
};